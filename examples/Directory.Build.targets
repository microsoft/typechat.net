<Project>
  <Target Name="CopyDefaultDevelopmentSettings" AfterTargets="CopyFilesToOutputDirectory"
          Condition="!Exists('$(MSBuildThisFileDirectory)appSettings.Development.json')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)appSettings.json"
          DestinationFiles="$(TargetDir)appSettings.Development.json" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)appSettings.Development.json" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="..\appSettings*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>